# /etc/gn-fee-collector/collector.env (chmod 600)
# BTC (lxbtc01). No BCH (lxbch02) use GN_COIN=BCH, GN_NODE_CONF=/etc/bitcoincash/bitcoin.conf, GN_NODE_DATADIR=/bitcoincash/bchnode
GN_COIN=BTC
GN_NODE_CONF=/etc/bitcoin/bitcoin.conf
GN_NODE_DATADIR=/var/lib/bitcoin
GN_RPC_URL=http://127.0.0.1:8332/
GN_SQL_HOST=<ip-do-sql-server>
GN_SQL_DB=bitcoin
GN_SQL_USER=gn_fee_collector
GN_SQL_PASS=<senha>
GN_INTERVALO_SEG=5
GN_RETENCAO_DIAS=30