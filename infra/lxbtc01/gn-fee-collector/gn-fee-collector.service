[Unit]
Description=GambleNumbers fee collector (tempo de confirmacao por taxa)
After=network-online.target bitcoind.service
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/gn-fee-collector/collector.env
ExecStart=/usr/bin/python3 -u /opt/gn-fee-collector/gn_fee_collector.py
Restart=always
RestartSec=30
Nice=10

[Install]
WantedBy=multi-user.target